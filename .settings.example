# 推荐在 pamu 中输入 /login 配置模型服务。模板值留空。
# 优先级：进程环境 > 工作区设置 > 用户设置 > 已保存的供应商配置。
PAMU_PROVIDER=
MODEL_ID=
FALLBACK_MODEL_ID=

# Anthropic Messages 及兼容供应商
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# OpenAI 官方 Responses
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 自定义兼容服务：协议取 openai_chat 或 openai_responses；地址和模型必填，密钥可选。
OPENAI_COMPATIBLE_PROTOCOL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Ollama 原生协议，默认地址 http://localhost:11434；无需密钥。
OLLAMA_BASE_URL=

# 日志级别：DEBUG / INFO / WARNING / ERROR；默认 INFO。
LOG_LEVEL=

# 启动模型的上下文窗口（tokens）；留空采用已知规划值或明确标注的假设。
PAMU_CONTEXT_WINDOW=
